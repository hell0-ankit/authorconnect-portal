# Local development environment. Never put real credentials in this file.
DJANGO_SETTINGS_MODULE=config.settings.development
ENVIRONMENT=dev
SECRET_KEY=

DB_NAME=authorconnect
DB_USER=authorconnect_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/0

# Optional: enables Gemini-powered admin support tools.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
