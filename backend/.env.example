# Required for Django startup and PostgreSQL access. Set real values in .env.
SECRET_KEY=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Local Windows PostgreSQL; Docker overrides this with host.docker.internal.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Production settings require explicit hosts and browser origins.
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://example.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Enable only after confirming every subdomain is HTTPS-ready.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Required for Gemini-powered admin ticket classification and reply drafts.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
REDIS_URL=redis://127.0.0.1:6379/0