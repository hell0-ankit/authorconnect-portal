# Required for Django startup and PostgreSQL access. Set real values in .env.
SECRET_KEY=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Local Windows PostgreSQL; Docker overrides this with host.docker.internal.
DB_HOST=127.0.0.1
DB_PORT=5432

# Required for Gemini-powered admin ticket classification and reply drafts.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
REDIS_URL=redis://127.0.0.1:6379/0